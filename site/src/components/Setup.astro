---
// The setup form. The shared preview window's contents are rendered here, at build time, from the same lists and
// templates the zip is built from (src/form/peek.js), and from public/SKILL.md.
import { checklists, issueForms } from '../form/peek.js';
import { Content as Skill } from '../../public/SKILL.md';

const stages = checklists();
const forms = issueForms();
const box = (b) => [b.where && b.pick ? `${b.where}: ${b.pick}` : b.where || b.pick].filter(Boolean)[0] ?? '';
---
<dialog id="setup" aria-labelledby="setupTitle">
    <div class="setup-inner">
      <button type="button" class="close" id="close" aria-label="Close the form"><svg aria-hidden="true"><use href="#i-close" /></svg></button>
      <div class="setup-grid">
        <div class="views">
        <nav class="stepbar off" id="stepBar" aria-label="Steps">
          <ol>
            <li><button type="button" data-step="1"><i>1</i><span>About</span></button></li>
            <li><button type="button" data-step="2"><i>2</i><span>CI checks</span></button></li>
            <li class="new-only"><button type="button" data-step="3"><i>3</i><span>Issues and checklists</span></button></li>
            <li><button type="button" data-step="4"><i>4</i><span><span class="new-only">README and website</span><span class="ex-only">Website</span></span></button></li>
            <li class="new-only"><button type="button" data-step="5"><i>5</i><span>Extras</span></button></li>
          </ol>
        </nav>
        <form id="form" onsubmit="return false" novalidate>
          <h2 id="setupTitle">Set up your package</h2>
          <p class="sub">A few questions. Nothing you type leaves your browser. <button type="button" class="reset" id="toExisting">Already have a package?</button></p>
          <div class="field">
            <div class="field-head"><label for="pkg">Package name</label><span class="tip" tabindex="0" aria-describedby="tip-pkg"><svg aria-hidden="true"><use href="#i-info" /></svg><span role="tooltip" id="tip-pkg">Letters, numbers and dots only, starting with a letter: no - or _. Going to CRAN? Check the name is free first: open cran.r-project.org/package=yourname.</span></span></div>
            <input id="pkg" type="text" maxlength="80" autocomplete="off" spellcheck="false" placeholder="fooBarPkg" aria-describedby="tip-pkg" />
            <p class="err" id="err-pkg"></p>
          </div>
          <div class="field">
            <div class="field-head"><label for="what">What it does, in one line <span class="opt">(up to 65 characters)</span></label><span class="tip" tabindex="0" aria-describedby="tip-what"><svg aria-hidden="true"><use href="#i-info" /></svg><span role="tooltip" id="tip-what">It becomes the Title in DESCRIPTION, and CRAN asks for 65 characters or fewer.</span></span></div>
            <input id="what" type="text" maxlength="65" autocomplete="off" placeholder="Tools for clinical tables" aria-describedby="tip-what" />
            <p class="err" id="err-what"></p>
          </div>
          <div class="field">
            <div class="field-head"><label for="details">Describe it in a sentence or two <span class="opt">(optional)</span></label><span class="tip" tabindex="0" aria-describedby="tip-details"><svg aria-hidden="true"><use href="#i-info" /></svg><span role="tooltip" id="tip-details">It becomes the Description in DESCRIPTION. Left empty, it repeats the line above; CRAN asks for more than that, so the Before CRAN checklist reminds you.</span></span></div>
            <textarea id="details" rows="2" maxlength="500" autocomplete="off" placeholder="Builds tables for clinical study reports from analysis datasets." aria-describedby="tip-details"></textarea>
            <p class="err" id="err-details"></p>
          </div>
          <div class="field two">
            <div><label for="first">Author first name</label><input id="first" type="text" autocomplete="off" /><p class="err" id="err-first"></p></div>
            <div><label for="last">Author last name</label><input id="last" type="text" autocomplete="off" /><p class="err" id="err-last"></p></div>
          </div>
          <div class="field">
            <div class="field-head"><label for="email">Email <span class="opt">(optional)</span></label><span class="tip" tabindex="0" aria-describedby="tip-email"><svg aria-hidden="true"><use href="#i-info" /></svg><span role="tooltip" id="tip-email">Goes in DESCRIPTION. Left empty, a placeholder goes there: replace it before you release, as CRAN needs a real one.</span></span></div>
            <input id="email" type="email" autocomplete="off" aria-describedby="tip-email" />
            <p class="err" id="err-email"></p>
          </div>
          <div class="field">
            <div class="field-head"><label for="owner">GitHub username or organisation</label><span class="tip" tabindex="0" aria-describedby="tip-owner"><svg aria-hidden="true"><use href="#i-info" /></svg><span role="tooltip" id="tip-owner">Where the package will live on GitHub, such as github.com/yourname/yourpackage. It fills in the links in your README and DESCRIPTION.</span></span></div>
            <input id="owner" type="text" autocomplete="off" spellcheck="false" aria-describedby="tip-owner owner-note" />
            <p class="err" id="err-owner"></p>
            <p class="field-note" id="owner-note">No GitHub account yet? <a href="https://github.com/signup" target="_blank" rel="noopener">Sign up free</a>, then come back with your username.</p>
          </div>
          <div class="how-row">
            <fieldset class="routes how" id="how">
              <legend class="sr">How do you want to set it up?</legend>
              <label><input type="radio" name="how" value="plan" checked /><span>Use a plan</span></label>
              <label><input type="radio" name="how" value="custom" id="custom" /><span>Customise a plan</span></label>
            </fieldset>
            <span class="tip" tabindex="0" role="note" aria-label="Use a plan: download it as it is. Customise a plan: start from one and change anything in four more steps."><svg aria-hidden="true"><use href="#i-info" /></svg><span role="tooltip" aria-hidden="true">Use a plan: download it as it is. Customise a plan: start from one and go through four more steps: checks, issues and checklists, README and website, and extras.</span></span>
          </div>
          <fieldset class="plans" id="plans">
            <legend id="planLegend" class="sr">What is the plan for this package?</legend>
            <label class="plan p1"><input type="radio" name="plan" value="a" checked /><i class="chip c1"></i><span><b>Public, going to CRAN</b><em>Anyone can install it</em></span></label>
            <label class="plan p2"><input type="radio" name="plan" value="b" /><i class="chip c2"></i><span><b>Public, not for CRAN</b><em>Installed from GitHub</em></span></label>
            <label class="plan p3"><input type="radio" name="plan" value="c" /><i class="chip c3"></i><span><b>Private for now</b><em>Public and CRAN later</em></span></label>
            <label class="plan p4"><input type="radio" name="plan" value="d" /><i class="chip c4"></i><span><b>Private for good</b><em>Company or personal</em></span></label>
          </fieldset>
          <p class="plan-line" id="planLine" role="status"></p>
          <div class="actions">
            <button type="button" class="primary" id="download" aria-disabled="true" aria-describedby="missing">Download <span id="dlName">fooBarPkg</span>.zip</button>
            <button type="button" class="primary" id="modify" hidden aria-disabled="true" aria-describedby="missing">Next</button>
          </div>
          <p class="note" id="missing" role="status"></p>
          <p class="note" id="planNote" role="status"></p>
                  </form>
        <section id="modifyView" aria-labelledby="modTitle" hidden>
          <h2 id="modTitle" tabindex="-1"><span id="stepTitle">CI checks on GitHub</span> <span class="for">for <span id="modPkg">fooBarPkg</span></span></h2>
          <p class="sub">Already set up for your plan. Change only what you want. <button type="button" class="reset" id="modReset" disabled>Back to recommended</button></p>
          <section class="mod" data-step="2" aria-label="CI checks on GitHub"><div class="mod-body" id="bodyCi"></div></section>
          <section class="mod new-only" data-step="3" aria-label="Issues and checklists"><div class="mod-body" id="bodyGit"></div></section>
          <section class="mod" data-step="4" aria-label="README and website"><div class="mod-body" id="bodySite"></div></section>
          <section class="mod new-only" data-step="5" aria-label="Extras"><div class="mod-body" id="bodyMore"></div></section>
          <div class="actions mod-actions"><button type="button" class="quiet" id="modBack">Back</button><button type="button" class="primary" id="stepNext">Next</button><button type="button" class="primary" id="modDownload" hidden>Download</button></div>
        </section>
        <section id="existingView" aria-labelledby="exTitle" hidden>
          <button type="button" class="back" id="exBack"><svg aria-hidden="true" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M10 3 5 8l5 5" /></svg>Start a new package instead</button>
          <h2 id="exTitle" tabindex="-1">Add launchR to your package</h2>
          <p class="sub">Choose what to add. R/, tests/ and DESCRIPTION are left alone.</p>
          <div class="field two">
            <div><label for="exPkg">Package name</label><input id="exPkg" type="text" autocomplete="off" spellcheck="false" /><p class="err" id="err-exPkg"></p></div>
            <div><label for="exOwner">GitHub name <span class="opt">(optional)</span></label><input id="exOwner" type="text" autocomplete="off" spellcheck="false" /><p class="err" id="err-exOwner"></p></div>
          </div>
          <fieldset class="routes wide" id="exPlans">
            <legend>Where is this package headed?</legend>
            <label><input type="radio" name="explan" value="a" checked /><span>Public, going to CRAN</span></label>
            <label><input type="radio" name="explan" value="b" /><span>Public, not for CRAN</span></label>
            <label><input type="radio" name="explan" value="c" /><span>Private for now</span></label>
            <label><input type="radio" name="explan" value="d" /><span>Private for good</span></label>
          </fieldset>
          <h3 class="ex-head">What to add</h3>
          <div class="exrows" id="exRows"></div>
          <div class="opt soonline"><span>Paste a GitHub link to see what is missing</span><span class="tag">Coming soon</span></div>
          <p class="note" id="exNote" role="status"></p>
          <p class="note" id="exFinder"></p>
          <div class="actions"><button type="button" class="primary" id="exDownload">Download the files</button><button type="button" class="quiet" id="exModify">Choose checks and systems</button></div>
        </section>
        <section id="nextView" aria-labelledby="nextTitle" hidden>
          <img class="launch-hex" id="launchHex" width="104" height="120" alt="" hidden />
          <h2 id="nextTitle" tabindex="-1"><span id="nextName">fooBarPkg</span>.zip is in your downloads</h2>
          <p class="sub">Now let's put it on GitHub.</p>
          <fieldset class="routes" id="routes">
            <legend>How do you want to do it?</legend>
            <label><input type="radio" name="route" value="r" checked /><span>In the R console</span></label>
            <label><input type="radio" name="route" value="desktop" /><span>With GitHub Desktop</span></label>
          </fieldset>
          <ol class="steps" id="stepList"></ol>
          <div class="after" id="nextAfter"></div>
          <div class="actions"><button type="button" class="primary" id="nextDone">Done</button><button type="button" class="quiet" id="nextChange">Change my choices</button></div>
        </section>
        </div>
        <aside class="preview" aria-label="What this plan gives you">
          <div class="pv-hex" id="pvHex">
            <svg viewBox="0 0 87 100" aria-hidden="true"><polygon points="43.500,3 84,26 84,74 43.500,97 3,74 3,26" /></svg>
            <span id="pvLetter">fB</span>
          </div>
          <p class="pv-name"><span id="pvName">fooBarPkg</span>.zip</p>
          <p class="pv-plan" aria-live="polite"><span id="pvPlan">Public, going to CRAN</span><span id="pvCustom" hidden>, customised</span></p>
          <dl class="pv-rows">
            <div><dt>Checks on GitHub</dt><dd id="pvChecks">All seven</dd></div>
            <div class="pv-more"><dt>Systems</dt><dd id="pvSystems"></dd></div>
            <div class="pv-more"><dt>Website</dt><dd id="pvSite"></dd></div>
            <div><dt>Checklists</dt><dd><ul id="pvLists" class="pv-lists"></ul></dd></div>
            <div><dt>Release features</dt><dd id="pvRelease" aria-live="polite"></dd></div>
          </dl>
        </aside>
      </div>
    </div>
    <dialog id="peek" class="peek" aria-labelledby="peekTitle">
      <div class="peek-head">
        <h2 id="peekTitle">Preview</h2>
        <button type="button" class="close peek-close" id="peekClose" aria-label="Close the preview"><svg aria-hidden="true"><use href="#i-close" /></svg></button>
      </div>
      <div class="peek-grid">
        <nav class="peek-list" aria-label="What to preview">
          <h3>Checklists</h3>
          <ul>{stages.map((s) => <li><button type="button" data-peek={`cl-${s.key}`}>{s.stage}</button></li>)}</ul>
          <h3>Issue forms</h3>
          <ul>{forms.map((f) => <li><button type="button" data-peek={`form-${f.key}`}>{f.title}</button></li>)}</ul>
          <h3>For AI assistants</h3>
          <ul><li><button type="button" data-peek="skill">SKILL.md</button></li></ul>
        </nav>
        <div class="peek-pane">
          {stages.map((s) => (
            <article class="peek-issue" data-peek={`cl-${s.key}`} hidden>
              <p class="peek-kind">Checklist issue, as GitHub shows it</p>
              <h3 class="peek-title">Checklist: {s.stage}</h3>
              <p class="peek-when">{s.opens}</p>
              {s.sections.map((sec) => (
                <>
                  <h4>{sec.name}</h4>
                  <ul class="peek-boxes">
                    {sec.boxes.map((b) => (
                      <li>
                        <span class="peek-box" aria-hidden="true"></span>
                        <span>{b.text.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}{box(b) && <em> ({box(b)})</em>}{b.auto && <span class="tag">launchR ticks this</span>}{b.cran && <span class="tag">CRAN only</span>}{b.needs && <span class="tag">{b.needs}</span>}</span>
                      </li>
                    ))}
                  </ul>
                </>
              ))}
              <p class="peek-foot">The date launchR last checked the list goes here.</p>
            </article>
          ))}
          {forms.map((f) => (
            <article class="peek-form" data-peek={`form-${f.key}`} hidden>
              <p class="peek-kind">Issue form, as GitHub shows it. It sets the label <code>{f.label}</code>.</p>
              <h3 class="peek-title">{f.name}</h3>
              <p class="peek-when">{f.description}</p>
              {f.body.map((part) => part.type === 'markdown' ? (
                <div class="peek-md">{part.value.split('\n').map((line) => <p>{line}</p>)}</div>
              ) : (
                <div class="peek-field">
                  <p class="peek-label">{part.label}{part.required && <span class="peek-req" aria-label="required"> *</span>}</p>
                  {part.description && <p class="peek-help">{part.description}</p>}
                  <div class={part.type === 'textarea' ? 'peek-input tall' : 'peek-input'} aria-hidden="true"></div>
                </div>
              ))}
            </article>
          ))}
          <article class="peek-md-doc" data-peek="skill" hidden>
            <p class="peek-kind">launchR's skill for AI agents, at <a href="/SKILL.md">/SKILL.md</a></p>
            <Skill />
          </article>
        </div>
      </div>
    </dialog>
  </dialog>
