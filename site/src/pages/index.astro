---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Icons from '../components/Icons.astro';
import Notice from '../components/Notice.astro';
import Setup from '../components/Setup.astro';
import Story from '../components/Story.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'launchR',
  url: 'https://launch-r.web.app/',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  description: 'Start an R package with tests, CI and GitHub set up, or add ready-made CI to one you have.',
  isAccessibleForFree: true,
  author: { '@type': 'Person', name: 'Harsh Verma' },
};
---
<Base
  title="launchR: start an R package, set up properly"
  description="Free and open source. Start an R package with tests, CI, GitHub files and checklists in place. Built in your browser, with no terminal needed."
  schema={schema}
>
  <a class="skip" href="#main">Skip to the content</a>
  <Icons />
  <Header />
  <div id="mask" aria-hidden="true"></div>
  <canvas id="scene" aria-hidden="true"></canvas>
  <button type="button" class="hub plain" id="launch" aria-haspopup="dialog"><span>Start your<br />package</span></button>
  <Story />
  <Setup />
  <Notice />
  <noscript><p class="no-script">The form and the pictures need JavaScript. The command line tool in the launchR repository makes the same package.</p></noscript>
  <script>
    import '../consent.js';
    import '../scene/page.js';
    import '../form/app.js';
  </script>
</Base>
